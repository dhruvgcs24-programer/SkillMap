<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="10dp"
    app:cardCornerRadius="10dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header row: accent bar | topic number + title | checkbox -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Purple left accent bar -->
            <View
                android:layout_width="4dp"
                android:layout_height="38dp"
                android:background="#7C4DFF"
                android:layout_marginEnd="10dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBLMTopicNum"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Topic 01"
                    android:textColor="#9E9EC8"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/tvBLMTopicTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#1A1A2E"
                    android:textSize="15sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbBLMTopicDone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#7C4DFF"/>
        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/tvBLMTopicDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#444444"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.5"
            android:layout_marginTop="10dp"/>

        <!-- Resource link rows — added programmatically -->
        <LinearLayout
            android:id="@+id/blmResContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>
